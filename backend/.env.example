# Copy to .env and fill in private values. Never commit .env.
APP_ENV=development
# One origin or a comma-separated list, e.g. https://shop.example.com,https://www.example.com
# In development, localhost and https sandbox previews are also accepted.
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TRUSTED_PROXY_HOPS=0
# Local PostgreSQL from docker-compose.yml; SQLite also works with sqlite:///store.db
DATABASE_URL=postgresql://technobaazar:technobaazar@localhost:5432/technobaazar
# Apply migrations explicitly; set true only for throwaway development.
AUTO_CREATE_TABLES=false
# Optional TLS settings for hosted PostgreSQL
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
UPLOAD_DIR=
PORT=5000
ADMIN_EMAIL=admin@example.com
# Use a unique password of at least 12 characters before npm run create-admin.
ADMIN_PASSWORD=replace-with-a-strong-password
