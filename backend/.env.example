# Copy to .env and fill in private values. Never commit .env.
APP_ENV=development
# One origin or a comma-separated list, e.g.
# FRONTEND_ORIGIN=https://shop.example.com,https://www.example.com
# In development, localhost and https sandbox previews are also accepted.
FRONTEND_ORIGIN=http://localhost:5173
FLASK_SECRET_KEY=replace-with-a-long-random-secret
TRUSTED_PROXY_HOPS=0
# SQLite by default. Local Postgres (see README "Local PostgreSQL"): start it with
# `python local_postgres.py start`, then use e.g.
# DATABASE_URL=postgresql+psycopg://postgres@/technobaazar?host=/home/user/pgdata
# Managed Postgres in production, e.g. postgresql+psycopg://user:pass@host:5432/technobaazar
DATABASE_URL=sqlite:///store.db
# Let the app create missing tables automatically (handy for dev). Use
# AUTO_CREATE_TABLES=false in production and run `flask --app app db upgrade`.
AUTO_CREATE_TABLES=true
UPLOAD_DIR=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
