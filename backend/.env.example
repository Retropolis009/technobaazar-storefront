# Copy to .env and fill in private values. Never commit .env.
APP_ENV=development
# One origin or a comma-separated list, e.g.
# FRONTEND_ORIGIN=https://shop.example.com,https://www.example.com
# In development, localhost and https sandbox previews are also accepted.
FRONTEND_ORIGIN=http://localhost:5173
FLASK_SECRET_KEY=replace-with-a-long-random-secret
TRUSTED_PROXY_HOPS=0
# Local PostgreSQL from docker-compose.yml; SQLite also works with sqlite:///store.db
DATABASE_URL=postgresql+psycopg://technobaazar:technobaazar@localhost:5432/technobaazar
# Apply Alembic migrations explicitly; set true only for throwaway prototyping.
AUTO_CREATE_TABLES=false
UPLOAD_DIR=
ADMIN_EMAIL=admin@example.com
# Use a unique password of at least 12 characters before create-admin.
ADMIN_PASSWORD=replace-with-a-strong-password
