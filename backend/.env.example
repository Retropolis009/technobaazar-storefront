APP_ENV=production
FRONTEND_ORIGIN=https://your-domain.example

SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

TRUSTED_PROXY_HOPS=1

DB_NAME=your_cpanel_account_store
DB_USER=your_cpanel_account_dbuser
DB_PASSWORD=replace-with-your-database-password

AUTO_CREATE_TABLES=false

ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
